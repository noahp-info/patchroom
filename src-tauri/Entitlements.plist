<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime, Developer ID (docs/SPEC.md section 11). Not sandboxed: the session host
       runs the real CLI in the user's login shell. Keep this list minimal. -->
  <!-- "Show in iTerm" scripts iTerm or Terminal through osascript (Info.plist explains why). -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
